# ── Database ────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_replace
POSTGRES_DB=gita
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_password_replace@localhost:5432/gita

# ── Security & Authentication ────────────────────────────────────────
JWT_SECRET=replace_with_a_64_char_secure_random_hex_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# ── Audio Storage & Streaming ────────────────────────────────────────
AUDIO_ROOT=/data/audio
AUDIO_BASE_URL=http://localhost:8000/audio
AUDIO_HOST_DIR=../data

# ── Application Environment ──────────────────────────────────────────
ENV=development
APP_NAME=Garbh Journey API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["*"]
